# File cấu hình môi trường mẫu (.env.example)
# Hãy copy file này thành .env và điền các tham số phù hợp

CLIP_MODEL_NAME=ViT-B/32
DEFAULT_NPY_PATH=data/features/clip_features.npy
DEFAULT_TOP_K=50
DEVICE=auto

# 9Router Proxy & AI Query Compiler Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_google_ai_key_here
LLM_MODEL=gemini-1.5-flash

# Database Connections
QDRANT_HOST=localhost
QDRANT_PORT=6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
